# RecoverEase Backend Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverease
# Optional fallback for local dev if PostgreSQL is not running:
# DATABASE_URL=sqlite:///./recoverease.db

SECRET_KEY=recoverease-secret-jwt-token-key-2025-super-secure-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Default Admin Seed Credentials
ADMIN_EMAIL=admin@recoverease.in
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Institute Head
